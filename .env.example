# Portable application home. By default this is <TruongNgocHoa install>\runtime,
# so selecting another drive in the installer keeps all app-owned files there.
# Use this override for development or portable deployments:
# TRUONGNGOCHOA_HOME=D:\TruongNgocHoaData
# RUNTIME_DATA_DIR defaults to TRUONGNGOCHOA_HOME\data; override only for migration.
# RUNTIME_DATA_DIR=D:\TruongNgocHoaData

# Whisper transcription
# Models: tiny, base, small, medium, large-v3
WHISPER_MODEL=small

# HY-MT2 local machine translation. The model downloads into HF_HOME on first use.
HYMT2_MODEL=tencent/Hy-MT2-1.8B

# Edge TTS requests are sent concurrently. Keep this between 1 and 4.
TTS_MAX_CONCURRENCY=1

# Without TRUONGNGOCHOA_HOME, advanced deployments may override individual caches.
# When TRUONGNGOCHOA_HOME is set, it is a hard boundary and these are ignored so a
# machine-wide environment variable cannot silently redirect files to drive C.
# HF_HOME=D:\TruongNgocHoaData\cache\huggingface
# TORCH_HOME=D:\TruongNgocHoaData\cache\torch
# PIP_CACHE_DIR=D:\TruongNgocHoaData\cache\pip
# UV_CACHE_DIR=D:\TruongNgocHoaData\cache\uv
# TRUONGNGOCHOA_TMP_DIR=D:\TruongNgocHoaData\cache\tmp
